    "gifs": {
      "@type": "Dataset",
      "@id": "https://dieghernan.github.io/gifs/#collection",
      "name": "Grandes incendios forestales en España",
      "url": "https://dieghernan.github.io/gifs/",
      "identifier": "https://doi.org/10.5281/zenodo.23932940",
      "sameAs": "https://doi.org/10.5281/zenodo.23932940",
      "isPartOf": "https://doi.org/10.5281/zenodo.23929996",
