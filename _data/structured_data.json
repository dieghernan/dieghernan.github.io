      "creator": {
        "@type": "Person",
        "name": "Diego HH",
        "url": "https://dieghernan.github.io/",
        "sameAs": "https://orcid.org/0000-0001-8457-4658",
        "@id": "https://dieghernan.github.io/gifs/#author"
      },
      "temporalCoverage": "2010-02-27/2026-09-26",
      "spatialCoverage": {
        "@type": "Place",
        "name": "España",
        "geo": {
          "@type": "GeoShape",
          "box": "27.9282566760271 -17.9896594 43.5444539 3.0381681",
          "description": "Extensión de los puntos con coordenadas disponibles; no representa los perímetros quemados ni implica cobertura territorial completa."
        }
      },
      "description": "Collection of selected EGIF reports on large forest fires in Spain from 2010–2023 and a reconciled fire-level view covering records from 2010–2026. EGIF takes priority where a documented match exists; other records retain their original MITECO reports. Reports and fires are different units and must not be added together. Some matches remain unresolved and coverage is incomplete. Locations use interpretable EGIF coordinates in EPSG:4326, with identified municipal reference points as a fallback in the fire-level view; they are not fire perimeters.",
      "hasPart": [
        "https://dieghernan.github.io/gifs/#dataset-parts",
        "https://dieghernan.github.io/gifs/#dataset-fires"
      ]
    }
