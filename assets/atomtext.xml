---
layout: null
permalink: ./atomtext.xml
---
{%- assign og_image = site.og_image | default: site.author.avatar | default: site.github.owner_gravatar_url -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.locale | default: 'en-US' | replace: '_', '-' | xml_escape }}">
	<generator uri="https://dieghernan.github.io/chulapa" version="1.0.0">Chulapa</generator>
	<link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
	<link href="{{  ""  | absolute_url }}" rel="alternate" type="text/html" />
	<id>{{ page.url | absolute_url }}</id>
	<title>{{ site.title | strip_html | xml_escape }}{% if site.subtitle %}{{ " | " | append: site.subtitle | strip_html | xml_escape }}{% endif %}</title>
	{% if site.subtitle -%}
	<subtitle>{{- site.subtitle | strip_html | xml_escape -}}</subtitle>
	{%- endif %}
	{% include snippets/author-identity.html %}
	<author>
		<name>{{ identity_name | xml_escape }}</name>
		{% if identity_url != empty %}<uri>{{ identity_url | absolute_url | xml_escape }}</uri>{% endif %}
	</author>
	<rights>(c) {{ site.time | date: '%Y' }}, {{  site.author.name | default: site.github.owner_name | xml_escape }}</rights>
	{% if site.navbar.brand.img -%}
	<icon>{{- site.navbar.brand.img | absolute_url | xml_escape -}}</icon>
	{%- endif %}
	{% if og_image %}<logo>{{ og_image | absolute_url | xml_escape }}</logo>{% endif %}
	{%- assign  alldocs = 	site.documents |
	            where_exp: "item", "item.include_on_feed == true" |
							where_exp: "item", "item.date != nil" |
							sort: 'date' | reverse -%}
  {%- assign feed_updated = alldocs.first.date | default: site.time -%}
  {%- assign feed_epoch = feed_updated | date: "%s" | plus: 0 -%}
  {%- for entry in alldocs -%}
    {%- assign entry_updated = entry.last_modified_at | default: entry.date -%}
    {%- assign entry_epoch = entry_updated | date: "%s" | plus: 0 -%}
    {%- if entry_epoch > feed_epoch -%}
      {%- assign feed_updated = entry_updated -%}
      {%- assign feed_epoch = entry_epoch -%}
    {%- endif -%}
  {%- endfor %}
  <updated>{{ feed_updated | date_to_xmlschema }}</updated>
	{%- for document in alldocs  -%}
		{%- include snippets/canonical-url.html url=document.url canonical=document.canonical_url -%}
		{%- assign entryimg =  document.og_image | default: document.header_img -%}
    {%- assign feed_title_html = document.title | markdownify -%}
    {%- include snippets/one-world-feed-plain-text.html html=feed_title_html -%}
	<entry>
		<title type="text">{{ feed_plain_text | xml_escape }}</title>
		<link href="{{ canonical_url | escape }}" rel="alternate" type="text/html" title="{{ feed_plain_text | xml_escape }}"/>
		<published>{{ document.date | date_to_xmlschema }}</published>
		<updated>{{ document.last_modified_at | default: document.date | date_to_xmlschema }}</updated>
		<id>{{ canonical_url | escape }}</id>
		<content type="html" xml:base="{{ canonical_path | absolute_url | uri_escape | escape }}">
		{% if document.subtitle %}
			{%- assign thesub = document.subtitle | markdownify -%}
			{%- assign thesub = thesub | remove: '<p>' | remove: '</p>' | strip | strip_newlines %}
		{{ '<h3>' | append: thesub | append: '</h3>' | escape }}
		{% endif %}
		{% if entryimg %}
{%- assign entryimg_url = entryimg | absolute_url | escape -%}
		{{ "<img src='" | append: entryimg_url | append: "' alt=''>" | escape }}
		{% endif %}

				{{ document.content | markdownify | escape }}
		</content>
		{% include snippets/author-identity.html author=document.author %}
		<author>
			<name>{{ identity_name | xml_escape }}</name>
			{% if identity_url != empty %}<uri>{{ identity_url | absolute_url | xml_escape }}</uri>{% endif %}
		</author>
		<summary type="html">{{ document.excerpt | escape }}</summary>
		<category term="{{ document.collection | xml_escape }}"/>
		{% assign tagrss = document.tags | sort -%}
		  {% for tag in tagrss  -%}
		<category term="{{ tag | xml_escape }}"/>
		  {%- endfor %}
	</entry>
    {%- endfor -%}
</feed>
