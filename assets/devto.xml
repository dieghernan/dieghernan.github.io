---
layout: null
permalink: ./devto.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
		<title>{{ site.title | append: " | " | append: site.subtitle | xml_escape  }}</title>
		<generator>(c) Chulapa Jekyll Theme RSS generator</generator>
		<link>{{  ""  | absolute_url }}</link>
		<description>{{ site.description | xml_escape }}</description>
		<language>{{- site.locale | default: 'en-US' -}}</language>
		<lastBuildDate>{{ site.time | date: "%a, %d %b %Y %H:%M:%S %z" }}</lastBuildDate>
		<atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
		{%- assign  alldocs = site.documents |
				where_exp: "item", "item.include_on_feed == true" |
				where_exp: "item", "item.date != nil" |
				sort: 'date' | reverse -%}
		{%- for document in alldocs limit: 10 -%}
			{%- include snippets/canonical-url.html url=document.url canonical=document.canonical_url -%}
			{%- assign ogimage = document.og_image | default: document.header_img | default: site.og_image -%}
		<item>
    {%- assign feed_title_html = document.title | markdownify -%}
    {%- include snippets/one-world-feed-plain-text.html html=feed_title_html -%}
			<title>{{ feed_plain_text | xml_escape }}</title>
			<link>{{ canonical_url | escape }}</link>
			<guid isPermaLink="true">{{ document.url | absolute_url | xml_escape }}</guid>
			{% if document.subtitle %}
			<description>{{ document.subtitle | markdownify | remove: '<p>' | remove: '</p>' | strip | strip_newlines | xml_escape }}</description>
			{% endif %}
			{% capture entry_html %}
			{% if document.subtitle %}
				{%- assign thesub = document.subtitle | markdownify -%}
				{%- assign thesub = thesub | remove: '<p>' | remove: '</p>' | strip | strip_newlines %}
{{ "<p>" | append: thesub | append: "</p>" }}
			{% endif %}
			{% if ogimage %}
{%- assign ogimage_url = ogimage | absolute_url | escape -%}
{{ "<p><img src='" | append: ogimage_url | append: "' alt=''></p>"  }}
			{% endif %}

{{ document.content | markdownify }}
			{% endcapture %}
			<content:encoded>{{ entry_html | xml_escape }}</content:encoded>
			<pubDate>{{ document.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
			{% if document.tags.size > 0 -%}
				{%- assign tagrss = document.tags | where_exp: "tag", "tag != document.layout" -%}
				{% for tag in tagrss  -%}
			<category>{{ tag | xml_escape }}</category>
				{%- endfor %}
			{%- endif %}
		</item>
	{%- endfor -%}
  </channel>
</rss>
