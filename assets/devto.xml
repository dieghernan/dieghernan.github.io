---
layout: null
permalink: ./devto.xml
---
{%- assign og_image = site.og_image | default: site.author.avatar | default: site.github.owner_gravatar_url | absolute_url -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" >
	<generator uri="https://dieghernan.github.io/chulapa" version="1.0.0">Chulapa</generator>
	<link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
	<link href="{{  ""  | absolute_url }}" rel="alternate" type="text/html" />
	<updated>{{ site.time | date_to_xmlschema }}</updated>
	<id>{{ page.url | absolute_url }}</id>
	<title>{{ site.title | strip_html  }}{% if site.subtitle %}{{ " | " | append: site.subtitle | strip_html }}{% endif %}</title>
	{% if site.subtitle -%}
	<subtitle>{{- site.subtitle | strip_html -}}</subtitle>
	{%- endif %}
	{% include snippets/author-identity.html %}
	<author>
		<name>{{ identity_name | xml_escape }}</name>
		{% if identity_url != empty %}<uri>{{ identity_url | absolute_url | xml_escape }}</uri>{% endif %}
	</author>
	<rights>(c) {{ site.time | date: '%Y' }}, {{  site.author.name | default: site.github.owner_name | xml_escape }}</rights>
	{% if site.navbar.brand.img -%}
	<icon>{{- site.navbar.brand.img | absolute_url -}}</icon>
	{%- endif %}
	<logo>{{- og_image -}}</logo>
	{%- assign alldocs = site.documents |
							where_exp: "item", "item.include_on_feed == true" |
							where_exp: "item", "item.date != nil" |
							sort: 'date' | reverse -%}
	{%- for document in alldocs limit: 5 -%}
		{%- include snippets/canonical-url.html url=document.url canonical=document.canonical_url -%}
		{%- assign entryimg = document.og_image | default: document.header_img | absolute_url -%}
		<entry>
			<title type="text">{{ document.title | markdownify | strip_html | normalize_whitespace | strip | replace: '&amp;', '&' | xml_escape }}</title>
			<link href="{{ canonical_url | escape }}" rel="alternate" type="text/html" title="{{ document.title | markdownify | strip_html | normalize_whitespace | strip | replace: '&amp;', '&' | xml_escape }}"/>
			<published>{{ document.date | date_to_xmlschema }}</published>
			<updated>{{ document.last_modified_at | default: document.date | date_to_xmlschema }}</updated>
			<id>{{ canonical_url | escape }}</id>
			<content type="html" xml:base="{{ canonical_path | absolute_url | uri_escape | escape }}">
			{% if document.subtitle %}

			{%- assign thesub = document.subtitle | markdownify -%}
			{%- assign thesub = thesub | remove: '<p>' | remove: '</p>' | strip | strip_newlines %}
			{{ '<p>' | append: thesub | append: '</p>' | escape }}
			{% endif %}

			{% if entryimg %}
			{{ "<img src='" | append: entryimg | append: "' >" | escape }}
			{% endif %}
			{{ "<p>Go to content</p>" | escape }}

			{{ document.content | markdownify | escape }}
			</content>
			<author>
				<name>{{ identity_name | xml_escape }}</name>
				{% if identity_url != empty %}
				<uri>{{ identity_url | absolute_url | xml_escape }}</uri>
				{% endif %}
			</author>
			<summary type="html">{{ document.excerpt | escape }}</summary>
			<category term="{{ document.collection }}"/>
			{% assign tagrss = document.tags | join: ',' | split: ',' | sort -%}
			{% for tag in tagrss -%}
			<category term="{{ tag }}"/>
			{%- endfor %}
		</entry>
	{%- endfor -%}
</feed>
